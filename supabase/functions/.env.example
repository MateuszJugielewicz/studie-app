# Secrets for edge functions: `supabase secrets set --env-file supabase/functions/.env`
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Signing secret of the second endpoint ("Connected accounts" events). Optional.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
PUBLIC_SITE_URL=https://easysesh.app
APNS_KEY_ID=ABC123DEFG
APNS_TEAM_ID=TEAMID1234
APNS_BUNDLE_ID=com.easysesh.app
APNS_PRODUCTION=false
# Contents of the AuthKey_XXXX.p8 file (keep the BEGIN/END lines)
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Sign in with Apple token revocation when an account is deleted (Apple Developer → Keys → a key
# with "Sign in with Apple"). Paste the whole .p8 file as APPLE_PRIVATE_KEY.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Shown on the public support page (…/functions/v1/legal/support).
SUPPORT_EMAIL=
