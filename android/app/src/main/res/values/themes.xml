<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- System launch screen: just the background colour, then the animated "easysesh" splash in Compose (as on iOS). -->
    <style name="Theme.EasySesh.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="postSplashScreenTheme">@style/Theme.EasySesh</item>
    </style>

    <style name="Theme.EasySesh" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
