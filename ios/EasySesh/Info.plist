<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>EasySesh</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>da</string>
		<string>de</string>
		<string>pl</string>
		<string>el</string>
		<string>fr</string>
		<string>es</string>
		<string>it</string>
		<string>sv</string>
		<string>nl</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.easysesh.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>easysesh</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>EasySeshApplePayMerchantId</key>
	<string>$(EASYSESH_APPLE_PAY_MERCHANT_ID)</string>
	<key>EasySeshStripePublishableKey</key>
	<string>$(EASYSESH_STRIPE_PUBLISHABLE_KEY)</string>
	<key>EasySeshSupabaseAnonKey</key>
	<string>$(EASYSESH_SUPABASE_ANON_KEY)</string>
	<key>EasySeshSupabaseURL</key>
	<string>$(EASYSESH_SUPABASE_URL)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
	</array>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Add your booked sessions to your calendar.</string>
	<key>NSCameraUsageDescription</key>
	<string>Take photos for your artist or studio profile.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>EasySesh uses your location to show recording studios near you and the distance to them.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose photos for your artist or studio profile.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
