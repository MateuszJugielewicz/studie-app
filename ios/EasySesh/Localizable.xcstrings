            "value": "Note la façon dont l'équipe EasySesh a traité ta demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuta come il team EasySesh ha gestito la tua richiesta."
          }
        },
        "nl": {
