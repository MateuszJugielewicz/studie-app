    "Verified artists get a badge. Link your Spotify or Instagram and our team will verify you.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificerede kunstnere får et mærke. Tilføj dit Spotify eller Instagram, så verificerer vores team dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifizierte Artists erhalten ein Abzeichen. Verlinke Spotify oder Instagram, dann verifiziert dich unser Team."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι επαληθευμένοι καλλιτέχνες παίρνουν σήμα. Σύνδεσε το Spotify ή το Instagram σου και η ομάδα μας θα σε επαληθεύσει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los artistas verificados obtienen una insignia. Enlaza tu Spotify o Instagram y nuestro equipo te verificará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les artistes vérifiés obtiennent un badge. Ajoute ton Spotify ou Instagram et notre équipe te vérifiera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli artisti verificati ricevono un badge. Collega Spotify o Instagram e il nostro team ti verificherà."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geverifieerde artiesten krijgen een badge. Koppel je Spotify of Instagram en ons team verifieert je."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweryfikowani artyści dostają odznakę. Dodaj Spotify lub Instagram, a nasz zespół Cię zweryfikuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifierade artister får ett märke. Länka ditt Spotify eller Instagram så verifierar vårt team dig."
          }
        }
      }
    },
