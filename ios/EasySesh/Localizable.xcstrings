    "Finish your listing and submit it. Our team checks every studio before it becomes visible.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør din profil færdig, og send den ind. Vores team tjekker alle studier, før de bliver synlige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell dein Inserat fertig und reiche es ein. Unser Team prüft jedes Studio, bevor es sichtbar wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ολοκλήρωσε την καταχώριση και υπέβαλέ την. Η ομάδα μας ελέγχει κάθε στούντιο πριν γίνει ορατό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina tu anuncio y envíalo. Nuestro equipo revisa cada estudio antes de que sea visible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine ton annonce et envoie-la. Notre équipe vérifie chaque studio avant sa publication."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa l'annuncio e invialo. Il nostro team verifica ogni studio prima che diventi visibile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak je vermelding af en stuur hem in. Ons team controleert elke studio voordat die zichtbaar wordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokończ ogłoszenie i wyślij je. Nasz zespół sprawdza każde studio, zanim stanie się widoczne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör klart din annons och skicka in den. Vårt team kontrollerar varje studio innan den blir synlig."
          }
        }
      }
    },
