    "Unfortunately your studio wasn't approved. You can update your listing and apply again.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Desværre blev dit studie ikke godkendt. Du kan opdatere din profil og søge igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leider wurde dein Studio nicht freigegeben. Du kannst dein Inserat aktualisieren und dich erneut bewerben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δυστυχώς το στούντιό σου δεν εγκρίθηκε. Μπορείς να ενημερώσεις την καταχώριση και να κάνεις ξανά αίτηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lamentablemente tu estudio no fue aprobado. Puedes actualizar tu anuncio y volver a solicitarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Malheureusement ton studio n'a pas été validé. Tu peux mettre à jour ton annonce et postuler à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Purtroppo lo studio non è stato approvato. Puoi aggiornare l'annuncio e candidarti di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Helaas is je studio niet goedgekeurd. Je kunt je vermelding bijwerken en opnieuw aanmelden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niestety Twoje studio nie zostało zatwierdzone. Możesz zaktualizować ogłoszenie i złożyć wniosek ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyvärr godkändes inte din studio. Du kan uppdatera annonsen och ansöka igen."
          }
        }
      }
    },
