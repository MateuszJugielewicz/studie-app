    "Bring %@ in cash to your session. Paying in the app gives you automatic refunds under the cancellation policy.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag %@ med i kontanter til din session. Betaler du i appen, får du automatisk refundering efter afbestillingsreglerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring %@ in bar zu deiner Session mit. Wenn du in der App zahlst, bekommst du automatische Erstattungen gemäß den Stornobedingungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φέρε %@ σε μετρητά στη συνεδρία σου. Αν πληρώσεις στην εφαρμογή, παίρνεις αυτόματες επιστροφές βάσει της πολιτικής ακύρωσης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva %@ en efectivo a tu sesión. Si pagas en la app, tienes reembolsos automáticos según la política de cancelación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apporte %@ en espèces à ta session. En payant dans l'app, tu bénéficies de remboursements automatiques selon la politique d'annulation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta %@ in contanti alla sessione. Pagando nell'app ottieni rimborsi automatici secondo la politica di cancellazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem %@ contant mee naar je sessie. Betaal je in de app, dan krijg je automatisch geld terug volgens het annuleringsbeleid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przynieś %@ w gotówce na sesję. Płacąc w aplikacji, otrzymasz automatyczne zwroty zgodnie z zasadami anulowania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta med %@ i kontanter till din session. Betalar du i appen får du automatisk återbetalning enligt avbokningsreglerna."
          }
        }
      }
    },
