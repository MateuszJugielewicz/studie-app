    "Bank details and identity checks are handled securely by Stripe, our payment provider.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankoplysninger og identitetstjek håndteres sikkert af Stripe, vores betalingsudbyder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankdaten und Identitätsprüfungen werden sicher von Stripe, unserem Zahlungsanbieter, abgewickelt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα τραπεζικά στοιχεία και οι έλεγχοι ταυτότητας γίνονται με ασφάλεια από το Stripe, τον πάροχο πληρωμών μας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos bancarios y la verificación de identidad los gestiona de forma segura Stripe, nuestro proveedor de pagos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coordonnées bancaires et les vérifications d'identité sont gérées en toute sécurité par Stripe, notre prestataire de paiement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati bancari e verifiche d'identità sono gestiti in sicurezza da Stripe, il nostro fornitore di pagamenti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
