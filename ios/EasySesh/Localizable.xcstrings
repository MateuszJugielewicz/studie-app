    "Reports are private. The other side isn't told who reported them.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldelser er fortrolige. Den anden part får ikke at vide, hvem der har anmeldt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldungen sind vertraulich. Die andere Seite erfährt nicht, wer gemeldet hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αναφορές είναι ιδιωτικές. Η άλλη πλευρά δεν μαθαίνει ποιος έκανε την αναφορά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las denuncias son privadas. La otra parte no sabe quién la denunció."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les signalements sont confidentiels. L'autre partie ne sait pas qui l'a signalée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le segnalazioni sono private. L'altra parte non saprà chi l'ha segnalata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen zijn privé. De andere partij hoort niet wie heeft gemeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgłoszenia są poufne. Druga strona nie dowie się, kto zgłosił."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmälningar är privata. Den andra parten får inte veta vem som anmälde."
          }
        }
      }
    },
