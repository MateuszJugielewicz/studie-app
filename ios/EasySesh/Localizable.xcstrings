    "This studio confirms requests manually, within 24 hours. Your card is authorised now and only charged if they accept.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Studiet bekræfter forespørgsler manuelt inden for 24 timer. Dit kort godkendes nu og trækkes kun, hvis de accepterer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Studio bestätigt Anfragen manuell innerhalb von 24 Stunden. Deine Karte wird jetzt autorisiert und nur belastet, wenn angenommen wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το στούντιο επιβεβαιώνει χειροκίνητα, εντός 24 ωρών. Η κάρτα σου εγκρίνεται τώρα και χρεώνεται μόνο αν αποδεχτούν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este estudio confirma manualmente, en 24 horas. Tu tarjeta se autoriza ahora y solo se cobra si aceptan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce studio confirme les demandes manuellement, sous 24 heures. Ta carte est autorisée maintenant et débitée seulement s'il accepte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo studio conferma manualmente, entro 24 ore. La carta viene autorizzata ora e addebitata solo se accettano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze studio bevestigt handmatig, binnen 24 uur. Je kaart wordt nu geautoriseerd en alleen belast als ze accepteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To studio potwierdza prośby ręcznie, w ciągu 24 godzin. Karta jest teraz autoryzowana i obciążona tylko po akceptacji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Studion bekräftar manuellt inom 24 timmar. Ditt kort godkänns nu och dras bara om de accepterar."
