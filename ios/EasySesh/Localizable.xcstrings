    },
    "We need a few changes before we can approve your studio. Update your listing and resubmit.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har brug for et par ændringer, før vi kan godkende dit studie. Opdatér din profil, og send den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir brauchen ein paar Änderungen, bevor wir dein Studio freigeben können. Aktualisiere dein Inserat und reiche es erneut ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρειαζόμαστε μερικές αλλαγές πριν εγκρίνουμε το στούντιο. Ενημέρωσε την καταχώριση και υπέβαλέ τη ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitamos algunos cambios antes de aprobar tu estudio. Actualiza tu anuncio y vuelve a enviarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nous faut quelques modifications avant de valider ton studio. Mets à jour ton annonce et renvoie-la."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono alcune modifiche prima di approvare lo studio. Aggiorna l'annuncio e invialo di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben een paar wijzigingen nodig voordat we je studio goedkeuren. Werk je vermelding bij en stuur hem opnieuw in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebujemy kilku zmian przed zatwierdzeniem studia. Zaktualizuj ogłoszenie i wyślij ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi behöver några ändringar innan vi kan godkänna din studio. Uppdatera annonsen och skicka in igen."
          }
        }
      }
    },
    "We record the version and time of your acceptance. You can withdraw consent by deleting your account in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi registrerer version og tidspunkt for din accept. Du kan trække dit samtykke tilbage ved at slette din konto under Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir speichern Version und Zeitpunkt deiner Zustimmung. Du kannst sie widerrufen, indem du dein Konto in den Einstellungen löschst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταγράφουμε την έκδοση και την ώρα της αποδοχής σου. Μπορείς να ανακαλέσεις τη συγκατάθεση διαγράφοντας τον λογαριασμό σου από τις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registramos la versión y la hora de tu aceptación. Puedes retirar el consentimiento eliminando tu cuenta en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous enregistrons la version et l'heure de ton acceptation. Tu peux retirer ton consentement en supprimant ton compte dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registriamo versione e ora della tua accettazione. Puoi revocare il consenso eliminando l'account nelle Impostazioni."
          }
        },
