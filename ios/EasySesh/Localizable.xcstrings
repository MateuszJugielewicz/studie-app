    "Promoted studios are shown at the top of Discover and search, with a Promoted tag.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Promoverede studier vises øverst i Opdag og søgning med et Promoveret-mærke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beworbene Studios erscheinen oben in Entdecken und in der Suche, mit dem Hinweis „Beworben“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα προβεβλημένα στούντιο εμφανίζονται πρώτα στην Ανακάλυψη και στην αναζήτηση, με την ετικέτα Προβεβλημένο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los estudios promocionados aparecen arriba en Descubrir y en las búsquedas, con la etiqueta Promocionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les studios mis en avant apparaissent en tête de Découvrir et des recherches, avec un badge Mis en avant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli studi in evidenza compaiono in cima a Scopri e alla ricerca, con l'etichetta In evidenza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgelichte studio's staan bovenaan in Ontdekken en zoeken, met een label Uitgelicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Promowane studia są wyświetlane na górze Odkrywaj i wyszukiwania z etykietą Promowane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Marknadsförda studior visas överst i Upptäck och sökningen, med märket Marknadsförd."
          }
        }
      }
    },
