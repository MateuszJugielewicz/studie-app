    "Fill in each section. When you're ready, submit your studio for review – our team usually replies within 1–2 business days.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udfyld hver sektion. Når du er klar, sender du dit studie til godkendelse – vores team svarer normalt inden for 1–2 hverdage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fülle jeden Abschnitt aus. Wenn du bereit bist, reiche dein Studio zur Prüfung ein – unser Team antwortet meist innerhalb von 1–2 Werktagen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συμπλήρωσε κάθε ενότητα. Όταν είσαι έτοιμος, υπέβαλε το στούντιο για έλεγχο – συνήθως απαντάμε σε 1–2 εργάσιμες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellena cada sección. Cuando estés listo, envía tu estudio a revisión: solemos responder en 1–2 días laborables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplis chaque section. Quand tu es prêt, soumets ton studio – notre équipe répond en général sous 1 à 2 jours ouvrés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compila ogni sezione. Quando sei pronto, invia lo studio per la verifica: di solito rispondiamo in 1–2 giorni lavorativi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul elk onderdeel in. Ben je klaar, stuur je studio dan ter beoordeling in – we reageren meestal binnen 1–2 werkdagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypełnij każdą sekcję. Gdy wszystko będzie gotowe, wyślij studio do weryfikacji – zwykle odpowiadamy w ciągu 1–2 dni roboczych."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyll i varje avsnitt. När du är klar skickar du in studion för granskning – vi svarar oftast inom 1–2 arbetsdagar."
          }
        }
      }
    },
