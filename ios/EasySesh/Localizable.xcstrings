    "Chat about your session, share references and get reminders before you go.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat om din session, del referencer og få påmindelser, før du tager af sted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatte über deine Session, teile Referenzen und erhalte Erinnerungen vor dem Termin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συζήτησε για τη συνεδρία, μοιράσου αναφορές και λάβε υπενθυμίσεις πριν πας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla de tu sesión, comparte referencias y recibe recordatorios antes de ir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discute de ta session, partage des références et reçois des rappels avant d'y aller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla della tua sessione, condividi riferimenti e ricevi promemoria prima di andare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat over je sessie, deel referenties en krijg herinneringen voordat je gaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmawiaj o sesji, dziel się inspiracjami i otrzymuj przypomnienia przed wyjściem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatta om din session, dela referenser och få påminnelser innan du går."
          }
        }
      }
    },
