    "Earnings, booking requests and upcoming sessions at a glance. Go live or pause your studio here.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtjening, bookinganmodninger og kommende sessions på ét sted. Gå live eller sæt studiet på pause her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einnahmen, Anfragen und anstehende Sessions auf einen Blick. Hier gehst du live oder pausierst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έσοδα, αιτήματα κρατήσεων και επερχόμενες συνεδρίες με μια ματιά. Εδώ ενεργοποιείς ή σταματάς το στούντιο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresos, solicitudes y próximas sesiones de un vistazo. Activa o pausa tu estudio aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenus, demandes et sessions à venir en un coup d'œil. Mets ton studio en ligne ou en pause ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guadagni, richieste e sessioni in arrivo a colpo d'occhio. Metti online o in pausa lo studio da qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkomsten, aanvragen en komende sessies in één oogopslag. Zet je studio hier live of op pauze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarobki, prośby o rezerwację i nadchodzące sesje w jednym miejscu. Tu włączysz lub wstrzymasz studio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Intäkter, förfrågningar och kommande sessioner i en överblick. Gå live eller pausa studion här."
          }
        }
      }
    },
    "EasySesh acts as payment agent for the studio. The service fee includes VAT where applicable.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "EasySesh optræder som betalingsagent for studiet. Servicegebyret inkluderer moms, hvor det gælder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EasySesh handelt als Zahlungsagent für das Studio. Die Servicegebühr enthält ggf. die MwSt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το EasySesh ενεργεί ως εκπρόσωπος πληρωμών του στούντιο. Η χρέωση υπηρεσίας περιλαμβάνει ΦΠΑ όπου ισχύει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "EasySesh actúa como agente de pago del estudio. La tarifa de servicio incluye el IVA cuando corresponde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "EasySesh agit comme agent de paiement du studio. Les frais de service incluent la TVA le cas échéant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "EasySesh agisce come agente di pagamento dello studio. La commissione di servizio include l'IVA ove applicabile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "EasySesh treedt op als betaalagent voor de studio. De servicekosten zijn inclusief btw waar van toepassing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "EasySesh działa jako agent płatności studia. Opłata serwisowa zawiera VAT, jeśli ma zastosowanie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "EasySesh agerar betalningsombud för studion. Serviceavgiften inkluderar moms där det gäller."
          }
        }
      }
    },
