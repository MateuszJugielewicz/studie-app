    "You have an overdue invoice. Pay it now to avoid suspension and debt collection. Contact support if you think this is a mistake.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har en forfalden faktura. Betal den nu for at undgå suspension og inkasso. Kontakt support, hvis du mener, det er en fejl."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast eine überfällige Rechnung. Bezahle sie jetzt, um Sperrung und Inkasso zu vermeiden. Wende dich an den Support, wenn du glaubst, dass das ein Fehler ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχεις ληξιπρόθεσμο τιμολόγιο. Πλήρωσέ το τώρα για να αποφύγεις αναστολή και είσπραξη οφειλών. Επικοινώνησε με την υποστήριξη αν πιστεύεις ότι είναι λάθος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes una factura vencida. Págala ya para evitar la suspensión y el cobro de la deuda. Contacta con soporte si crees que es un error."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as une facture en retard. Paie-la maintenant pour éviter la suspension et le recouvrement. Contacte l'assistance si tu penses que c'est une erreur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai una fattura scaduta. Pagala ora per evitare sospensione e recupero crediti. Contatta l'assistenza se pensi che sia un errore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt een achterstallige factuur. Betaal hem nu om schorsing en incasso te voorkomen. Neem contact op met support als je denkt dat dit een fout is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz zaległą fakturę. Opłać ją teraz, aby uniknąć zawieszenia i windykacji. Skontaktuj się z pomocą, jeśli uważasz, że to pomyłka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har en förfallen faktura. Betala den nu för att undvika avstängning och inkasso. Kontakta support om du tror att det är fel."
          }
        }
      }
    },
    "You owe %@ in platform fees for cash bookings. It's deducted from your next payout.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skylder %@ i platformgebyrer for kontantbookinger. Det trækkes fra din næste udbetaling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du schuldest %@ an Plattformgebühren für Barbuchungen. Der Betrag wird von deiner nächsten Auszahlung abgezogen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οφείλεις %@ σε χρεώσεις πλατφόρμας για κρατήσεις με μετρητά. Αφαιρούνται από την επόμενη πληρωμή σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes %@ en tarifas de plataforma por reservas en efectivo. Se descuenta de tu próximo pago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dois %@ de frais de plateforme pour des réservations en espèces. Ils sont déduits de ton prochain versement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devi %@ di commissioni per prenotazioni in contanti. Vengono detratte dal prossimo pagamento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent %@ aan platformkosten voor contante boekingen verschuldigd. Dit wordt van je volgende uitbetaling afgetrokken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalegasz %@ z tytułu opłat platformy za rezerwacje gotówkowe. Kwota zostanie potrącona z następnej wypłaty."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är skyldig %@ i plattformsavgifter för kontantbokningar. Det dras från din nästa utbetalning."
          }
        }
      }
    },
