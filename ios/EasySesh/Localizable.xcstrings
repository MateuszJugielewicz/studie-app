    "In-app payment isn't available yet, and this studio doesn't accept cash. Message the studio to arrange your session.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Betaling i appen er ikke tilgængelig endnu, og studiet tager ikke imod kontanter. Skriv til studiet for at aftale din session."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlung in der App ist noch nicht verfügbar und dieses Studio nimmt kein Bargeld. Schreib dem Studio, um deine Session abzusprechen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πληρωμή στην εφαρμογή δεν είναι ακόμα διαθέσιμη και το στούντιο δεν δέχεται μετρητά. Στείλε μήνυμα στο στούντιο για να κανονίσετε τη συνεδρία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago en la app aún no está disponible y este estudio no acepta efectivo. Escribe al estudio para organizar tu sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement dans l'app n'est pas encore disponible et ce studio n'accepte pas les espèces. Écris au studio pour organiser ta session."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento in app non è ancora disponibile e questo studio non accetta contanti. Scrivi allo studio per organizzare la sessione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Betalen in de app kan nog niet en deze studio accepteert geen contant geld. Stuur de studio een bericht om je sessie te regelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płatność w aplikacji nie jest jeszcze dostępna, a to studio nie przyjmuje gotówki. Napisz do studia, aby umówić sesję."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Betalning i appen är inte tillgänglig än och studion tar inte kontanter. Skriv till studion för att ordna din session."
          }
        }
      }
    },
    "In-app payment isn't available yet. EasySesh sends you an invoice and switches the promotion on once it's paid.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Betaling i appen er ikke tilgængelig endnu. EasySesh sender dig en faktura og slår promoveringen til, når den er betalt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlung in der App ist noch nicht verfügbar. EasySesh schickt dir eine Rechnung und schaltet die Werbung nach Zahlung frei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πληρωμή στην εφαρμογή δεν είναι ακόμα διαθέσιμη. Το EasySesh σου στέλνει τιμολόγιο και ενεργοποιεί την προβολή μόλις πληρωθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago en la app aún no está disponible. EasySesh te envía una factura y activa la promoción cuando se paga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement dans l'app n'est pas encore disponible. EasySesh t'envoie une facture et active la mise en avant une fois payée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento in app non è ancora disponibile. EasySesh ti invia una fattura e attiva la promozione una volta pagata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Betalen in de app kan nog niet. EasySesh stuurt je een factuur en zet de promotie aan zodra die betaald is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płatność w aplikacji nie jest jeszcze dostępna. EasySesh wyśle fakturę i włączy promocję po opłaceniu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Betalning i appen är inte tillgänglig än. EasySesh skickar en faktura och aktiverar marknadsföringen när den är betald."
          }
        }
      }
    },
