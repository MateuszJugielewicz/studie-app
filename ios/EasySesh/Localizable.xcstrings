          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte de l'artiste est autorisée. Accepter la débite, refuser libère la réservation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La carta dell'artista è autorizzata. Accettando viene addebitata, rifiutando si sblocca."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kaart van de artiest is geautoriseerd. Accepteren schrijft af, weigeren geeft het bedrag vrij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta artysty jest autoryzowana. Akceptacja ją obciąży, odrzucenie zwolni blokadę."
          }
        },
