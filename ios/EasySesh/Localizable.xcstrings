    "%@ wants to send you a message": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vil gerne sende dig en besked"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ möchte dir eine Nachricht schicken"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ θέλει να σου στείλει μήνυμα"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quiere enviarte un mensaje"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ veut t'envoyer un message"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vuole mandarti un messaggio"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wil je een bericht sturen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chce wysłać Ci wiadomość"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vill skicka ett meddelande till dig"
          }
        }
      }
    },
    "%@ wants to show your artist profile on its page, and the studio on your profile.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vil gerne vise din kunstnerprofil på sin side og studiet på din profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ möchte dein Artist-Profil auf seiner Seite zeigen und das Studio in deinem Profil."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ θέλει να δείχνει το προφίλ σου στη σελίδα του και το στούντιο στο προφίλ σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quiere mostrar tu perfil de artista en su página y el estudio en tu perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ veut afficher ton profil d'artiste sur sa page, et le studio sur ton profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vuole mostrare il tuo profilo artista sulla sua pagina e lo studio sul tuo profilo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wil je artiestenprofiel op zijn pagina tonen en de studio op jouw profiel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chce pokazać Twój profil artysty na swojej stronie, a studio na Twoim profilu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vill visa din artistprofil på sin sida och studion på din profil."
          }
        }
      }
    },
