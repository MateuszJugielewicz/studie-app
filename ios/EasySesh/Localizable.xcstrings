    },
    "You can only report a problem on a confirmed or completed booking.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan kun anmelde et problem på en bekræftet eller gennemført booking."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst nur bei bestätigten oder abgeschlossenen Buchungen ein Problem melden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να αναφέρεις πρόβλημα μόνο σε επιβεβαιωμένη ή ολοκληρωμένη κράτηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo puedes informar de un problema en reservas confirmadas o completadas."
          }
        },
        "fr": {
          "stringUnit": {
