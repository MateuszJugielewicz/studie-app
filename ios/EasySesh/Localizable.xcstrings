    "Our moderation team will look into it, usually within 24 hours. We may contact you if we need more details.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vores moderatorer ser på det, normalt inden for 24 timer. Vi kontakter dig måske, hvis vi har brug for flere detaljer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unser Moderationsteam sieht sich das an, meist innerhalb von 24 Stunden. Wir melden uns eventuell, wenn wir mehr Details brauchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ομάδα εποπτείας θα το εξετάσει, συνήθως μέσα σε 24 ώρες. Ίσως επικοινωνήσουμε μαζί σου για λεπτομέρειες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuestro equipo de moderación lo revisará, normalmente en 24 horas. Puede que te contactemos si necesitamos más detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notre équipe de modération va s'en occuper, en général sous 24 heures. Nous pourrons te contacter si besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nostro team di moderazione se ne occuperà, di solito entro 24 ore. Potremmo contattarti per altri dettagli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ons moderatieteam kijkt ernaar, meestal binnen 24 uur. We nemen misschien contact op als we meer informatie nodig hebben."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasz zespół moderacji zajmie się tym, zwykle w ciągu 24 godzin. Możemy się z Tobą skontaktować, jeśli będziemy potrzebować szczegółów."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vårt modereringsteam tittar på det, oftast inom 24 timmar. Vi kan kontakta dig om vi behöver mer information."
          }
        }
      }
    },
    "Our moderation team will look into it.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vores moderatorer kigger på det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unser Moderationsteam sieht sich das an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ομάδα ελέγχου θα το εξετάσει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuestro equipo de moderación lo revisará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notre équipe de modération va s'en occuper."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nostro team di moderazione se ne occuperà."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ons moderatieteam kijkt ernaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasz zespół moderatorów to sprawdzi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vårt moderatorteam tittar på det."
          }
        }
      }
    },
    "Our team checks the booking and the rating. If it breaks our guidelines or isn't about a real session, we remove it.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vores team tjekker bookingen og bedømmelsen. Hvis den bryder vores retningslinjer eller ikke handler om en rigtig session, fjerner vi den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unser Team prüft Buchung und Bewertung. Verstößt sie gegen unsere Richtlinien oder betrifft keine echte Session, entfernen wir sie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ομάδα μας ελέγχει την κράτηση και τη βαθμολογία. Αν παραβιάζει τις οδηγίες μας ή δεν αφορά πραγματική συνεδρία, την αφαιρούμε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuestro equipo revisa la reserva y la valoración. Si incumple nuestras normas o no trata de una sesión real, la eliminamos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notre équipe vérifie la réservation et la note. Si elle enfreint nos règles ou ne concerne pas une vraie session, nous la supprimons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nostro team controlla prenotazione e valutazione. Se viola le linee guida o non riguarda una sessione reale, la rimuoviamo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ons team controleert de boeking en de beoordeling. Als die onze richtlijnen schendt of niet over een echte sessie gaat, verwijderen we hem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasz zespół sprawdzi rezerwację i ocenę. Jeśli narusza zasady lub nie dotyczy prawdziwej sesji, usuniemy ją."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vårt team granskar bokningen och betyget. Bryter det mot våra riktlinjer eller gäller det inte en riktig session tar vi bort det."
          }
        }
      }
    },
