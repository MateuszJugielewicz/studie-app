    "Use at least 10 characters with upper- and lowercase letters and a number.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug mindst 10 tegn med store og små bogstaver og et tal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens 10 Zeichen mit Groß- und Kleinbuchstaben und einer Zahl."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τουλάχιστον 10 χαρακτήρες με κεφαλαία, πεζά και έναν αριθμό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos 10 caracteres con mayúsculas, minúsculas y un número."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins 10 caractères avec majuscules, minuscules et un chiffre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Almeno 10 caratteri con maiuscole, minuscole e un numero."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minstens 10 tekens met hoofdletters, kleine letters en een cijfer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj co najmniej 10 znaków, wielkich i małych liter oraz cyfry."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minst 10 tecken med stora och små bokstäver och en siffra."
          }
        }
      }
    },
