    "We couldn't find that address. Check the spelling.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke finde adressen. Tjek stavningen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten die Adresse nicht finden. Prüfe die Schreibweise."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρήκαμε τη διεύθυνση. Έλεγξε την ορθογραφία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No encontramos esa dirección. Revisa la ortografía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse introuvable. Vérifie l'orthographe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indirizzo non trovato. Controlla l'ortografia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden dat adres niet vinden. Controleer de spelling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleźliśmy tego adresu. Sprawdź pisownię."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi hittade inte adressen. Kontrollera stavningen."
          }
        }
      }
    },
    "We couldn't find that.": {
      "extractionState": "manual",
