    "Keep payments and bookings inside EasySesh – you're protected by our refund policy.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold betalinger og bookinger i EasySesh – så er du beskyttet af vores refunderingspolitik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wickle Zahlungen und Buchungen über EasySesh ab – so schützt dich unsere Erstattungsrichtlinie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κράτα πληρωμές και κρατήσεις μέσα στο EasySesh – σε προστατεύει η πολιτική επιστροφών μας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pagos y reservas dentro de EasySesh: te protege nuestra política de reembolso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde paiements et réservations dans EasySesh – tu es protégé par notre politique de remboursement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni pagamenti e prenotazioni su EasySesh: sei protetto dalla nostra politica di rimborso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd betalingen en boekingen binnen EasySesh – dan ben je beschermd door ons terugbetalingsbeleid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płać i rezerwuj w EasySesh – wtedy chroni Cię nasza polityka zwrotów."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll betalningar och bokningar i EasySesh – då skyddas du av vår återbetalningspolicy."
          }
        }
      }
    },
