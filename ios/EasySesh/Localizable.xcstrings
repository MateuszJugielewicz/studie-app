    "You can check in from 1 hour before your session until it ends.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan tjekke ind fra 1 time før din session, indtil den slutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst ab 1 Stunde vor deiner Session bis zu ihrem Ende einchecken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να κάνεις check-in από 1 ώρα πριν τη συνεδρία μέχρι να τελειώσει."
          }
        },
        "es": {
