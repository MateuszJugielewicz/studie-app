    "Find and book studios, pay in the app or cash, and chat with studios about your sessions.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Find og book studier, betal i appen eller kontant, og skriv med studier om dine sessioner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde und buche Studios, zahle in der App oder bar und chatte mit Studios über deine Sessions."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρες και κλείσε στούντιο, πλήρωσε στην εφαρμογή ή με μετρητά και μίλα με τα στούντιο για τις συνεδρίες σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra y reserva estudios, paga en la app o en efectivo y chatea con los estudios sobre tus sesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve et réserve des studios, paie dans l'app ou en espèces et discute avec les studios de tes sessions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova e prenota studi, paga nell'app o in contanti e chatta con gli studi sulle tue sessioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind en boek studio's, betaal in de app of contant en chat met studio's over je sessies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajduj i rezerwuj studia, płać w aplikacji lub gotówką i pisz ze studiami o sesjach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitta och boka studior, betala i appen eller kontant och chatta med studior om dina sessioner."
          }
        }
      }
    },
