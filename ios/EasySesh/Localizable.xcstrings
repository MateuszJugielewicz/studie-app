    "Please don't share card numbers or passwords. The EasySesh team can see your account and bookings.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del ikke kortnumre eller adgangskoder. EasySesh-teamet kan se din konto og dine bookinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte teile keine Kartennummern oder Passwörter. Das EasySesh-Team sieht dein Konto und deine Buchungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μη μοιράζεσαι αριθμούς καρτών ή κωδικούς. Η ομάδα EasySesh βλέπει τον λογαριασμό και τις κρατήσεις σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No compartas números de tarjeta ni contraseñas. El equipo de EasySesh puede ver tu cuenta y tus reservas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne partage pas de numéros de carte ni de mots de passe. L'équipe EasySesh voit ton compte et tes réservations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non condividere numeri di carta o password. Il team EasySesh vede il tuo account e le prenotazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel geen kaartnummers of wachtwoorden. Het EasySesh-team kan je account en boekingen zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie podawaj numerów kart ani haseł. Zespół EasySesh widzi Twoje konto i rezerwacje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela inte kortnummer eller lösenord. EasySesh-teamet kan se ditt konto och dina bokningar."
          }
        }
      }
    },
    "Please follow our Community Guidelines. Further breaches can lead to your account being suspended or banned.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg vores retningslinjer for fællesskabet. Yderligere overtrædelser kan føre til, at din konto suspenderes eller udelukkes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte halte dich an unsere Community-Richtlinien. Weitere Verstöße können zur Sperrung deines Kontos führen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακολούθησε τις Οδηγίες Κοινότητας. Περαιτέρω παραβιάσεις μπορεί να οδηγήσουν σε αναστολή ή αποκλεισμό του λογαριασμού σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue nuestras normas de la comunidad. Nuevas infracciones pueden llevar a la suspensión o bloqueo de tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Respecte nos règles de la communauté. D'autres manquements peuvent entraîner la suspension ou le bannissement de ton compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispetta le nostre linee guida della community. Ulteriori violazioni possono portare alla sospensione o al ban dell'account."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg onze communityrichtlijnen. Verdere overtredingen kunnen leiden tot schorsing of verbanning van je account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przestrzegaj naszych zasad społeczności. Kolejne naruszenia mogą skutkować zawieszeniem lub zablokowaniem konta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ våra gemenskapsriktlinjer. Fler överträdelser kan leda till att ditt konto stängs av."
          }
        }
      }
    },
    "Please read and accept the documents below to use EasySesh.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læs og acceptér dokumenterne nedenfor for at bruge EasySesh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte lies und akzeptiere die folgenden Dokumente, um EasySesh zu nutzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάβασε και αποδέξου τα παρακάτω έγγραφα για να χρησιμοποιήσεις το EasySesh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee y acepta los documentos siguientes para usar EasySesh."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lis et accepte les documents ci-dessous pour utiliser EasySesh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi e accetta i documenti qui sotto per usare EasySesh."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees en accepteer de documenten hieronder om EasySesh te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeczytaj i zaakceptuj poniższe dokumenty, aby korzystać z EasySesh."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läs och godkänn dokumenten nedan för att använda EasySesh."
          }
        }
      }
    },
    "Please read the updated documents again and accept them to keep using EasySesh.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læs de opdaterede dokumenter igen, og acceptér dem for at fortsætte med at bruge EasySesh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte lies die aktualisierten Dokumente erneut und akzeptiere sie, um EasySesh weiter zu nutzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάβασε ξανά τα ενημερωμένα έγγραφα και αποδέξου τα για να συνεχίσεις να χρησιμοποιείς το EasySesh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a leer los documentos actualizados y acéptalos para seguir usando EasySesh."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lis à nouveau les documents mis à jour et accepte-les pour continuer à utiliser EasySesh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rileggi i documenti aggiornati e accettali per continuare a usare EasySesh."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees de bijgewerkte documenten opnieuw en accepteer ze om EasySesh te blijven gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeczytaj ponownie zaktualizowane dokumenty i zaakceptuj je, aby dalej korzystać z EasySesh."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läs de uppdaterade dokumenten igen och godkänn dem för att fortsätta använda EasySesh."
          }
        }
      }
    },
    "Please sign in to continue.": {
