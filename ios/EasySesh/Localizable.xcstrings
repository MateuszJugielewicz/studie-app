    "What was great? What could be better?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad var godt? Hvad kunne være bedre?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was war super? Was könnte besser sein?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι ήταν τέλειο; Τι θα μπορούσε να είναι καλύτερο;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué estuvo genial? ¿Qué podría mejorar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui était top ? Qu'est-ce qui pourrait être mieux ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa è andato alla grande? Cosa si può migliorare?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat was top? Wat kan beter?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co było świetne? Co mogłoby być lepsze?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad var bra? Vad kunde vara bättre?"
          }
        }
      }
    },
    "What went wrong? Our team will review the booking and contact both sides.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad gik galt? Vores team gennemgår bookingen og kontakter begge parter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist schiefgelaufen? Unser Team prüft die Buchung und kontaktiert beide Seiten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι πήγε στραβά; Η ομάδα μας θα ελέγξει την κράτηση και θα επικοινωνήσει και με τις δύο πλευρές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué salió mal? Nuestro equipo revisará la reserva y contactará con ambas partes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui n'a pas marché ? Notre équipe va examiner la réservation et contacter les deux parties."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa è andato storto? Il nostro team esaminerà la prenotazione e contatterà entrambe le parti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat ging er mis? Ons team bekijkt de boeking en neemt contact op met beide partijen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co poszło nie tak? Nasz zespół sprawdzi rezerwację i skontaktuje się z obiema stronami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad gick fel? Vårt team granskar bokningen och kontaktar båda parter."
          }
        }
      }
    },
    "What's it about?": {
