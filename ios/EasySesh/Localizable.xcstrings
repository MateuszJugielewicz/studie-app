      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan vil du betale?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie möchtest du bezahlen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πώς θέλεις να πληρώσεις;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo quieres pagar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment veux-tu payer ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come vuoi pagare?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe wil je betalen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak chcesz zapłacić?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur vill du betala?"
          }
        }
      }
    },
    "How was the session? Punctual, respectful, prepared?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan gik sessionen? Punktlig, respektfuld, forberedt?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie war die Session? Pünktlich, respektvoll, vorbereitet?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πώς ήταν η συνεδρία; Συνέπεια, σεβασμός, προετοιμασία;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué tal la sesión? ¿Puntual, respetuoso, preparado?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment s'est passée la session ? Ponctuel, respectueux, préparé ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Com'è andata la sessione? Puntuale, rispettoso, preparato?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe was de sessie? Op tijd, respectvol, voorbereid?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak minęła sesja? Punktualnie, z szacunkiem, przygotowany?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur var sessionen? Punktlig, respektfull, förberedd?"
          }
        }
      }
    },
    "I accept the Terms and the Privacy Policy": {
      "extractionState": "manual",
      "localizations": {
