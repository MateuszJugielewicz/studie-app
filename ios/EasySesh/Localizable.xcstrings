    "Checking in records that the artist arrived. It protects both of you against fraud and helps EasySesh settle disputes.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek ind registrerer, at kunstneren er ankommet. Det beskytter jer begge mod svindel og hjælper EasySesh med at afgøre uenigheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Check-in hält fest, dass der Artist angekommen ist. Das schützt euch beide vor Betrug und hilft EasySesh, Streitfälle zu klären."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το check-in καταγράφει ότι ο καλλιτέχνης έφτασε. Προστατεύει και τους δύο από απάτη και βοηθά το EasySesh να επιλύει διαφορές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El check-in registra que el artista llegó. Os protege a ambos del fraude y ayuda a EasySesh a resolver disputas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement atteste l'arrivée de l'artiste. Il vous protège tous les deux contre la fraude et aide EasySesh à régler les litiges."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il check-in registra l'arrivo dell'artista. Vi protegge entrambi dalle frodi e aiuta EasySesh a risolvere le contestazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inchecken legt vast dat de artiest aankwam. Het beschermt jullie allebei tegen fraude en helpt EasySesh geschillen op te lossen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zameldowanie potwierdza przybycie artysty. Chroni was oboje przed oszustwem i pomaga EasySesh rozstrzygać spory."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Incheckningen registrerar att artisten kom. Det skyddar er båda mot bedrägeri och hjälper EasySesh att lösa tvister."
          }
        }
      }
    },
