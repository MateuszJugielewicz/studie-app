          "stringUnit": {
            "state": "translated",
            "value": "Du betaler kun, hvis de accepterer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du zahlst nur, wenn angenommen wird."
          }
        },
