    "Rate how the EasySesh team handled your request.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedøm, hvordan EasySesh-teamet håndterede din henvendelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewerte, wie das EasySesh-Team deine Anfrage bearbeitet hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βαθμολόγησε πώς χειρίστηκε η ομάδα το αίτημά σου."
          }
        },
        "es": {
