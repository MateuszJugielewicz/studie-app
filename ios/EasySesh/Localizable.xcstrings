    "Questions about a booking, a payment or your account? Send us a message and the EasySesh team will answer here.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørgsmål om en booking, en betaling eller din konto? Send os en besked, så svarer EasySesh-teamet her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen zu einer Buchung, einer Zahlung oder deinem Konto? Schreib uns, das EasySesh-Team antwortet hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ερωτήσεις για κράτηση, πληρωμή ή τον λογαριασμό σου; Στείλε μας μήνυμα και η ομάδα EasySesh θα απαντήσει εδώ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dudas sobre una reserva, un pago o tu cuenta? Escríbenos y el equipo de EasySesh te responderá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une question sur une réservation, un paiement ou ton compte ? Écris-nous, l'équipe EasySesh te répondra ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Domande su una prenotazione, un pagamento o il tuo account? Scrivici e il team EasySesh risponderà qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vragen over een boeking, een betaling of je account? Stuur ons een bericht, dan antwoordt het EasySesh-team hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytania o rezerwację, płatność lub konto? Napisz do nas, a zespół EasySesh odpowie tutaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Frågor om en bokning, en betalning eller ditt konto? Skicka ett meddelande så svarar EasySesh-teamet här."
          }
        }
      }
    },
