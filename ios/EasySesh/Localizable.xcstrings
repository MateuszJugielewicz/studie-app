    },
    "Tell us what happened. Dates, messages and names help us act faster.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortæl, hvad der skete. Datoer, beskeder og navne hjælper os med at handle hurtigere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzähl uns, was passiert ist. Daten, Nachrichten und Namen helfen uns, schneller zu handeln."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πες μας τι συνέβη. Ημερομηνίες, μηνύματα και ονόματα μας βοηθούν να δράσουμε γρηγορότερα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntanos qué pasó. Fechas, mensajes y nombres nos ayudan a actuar más rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explique-nous ce qui s'est passé. Dates, messages et noms nous aident à agir plus vite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccontaci cosa è successo. Date, messaggi e nomi ci aiutano ad agire più in fretta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertel wat er gebeurde. Data, berichten en namen helpen ons sneller te handelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz, co się stało. Daty, wiadomości i nazwy pomogą nam działać szybciej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Berätta vad som hände. Datum, meddelanden och namn hjälper oss att agera snabbare."
          }
        }
      }
    },
    "Tell us why the rating is unfair (at least 10 characters).": {
