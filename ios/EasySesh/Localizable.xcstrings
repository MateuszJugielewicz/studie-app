    "The artist's card is authorised. Accepting charges it; declining releases the hold.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunstnerens kort er godkendt. Accepterer du, trækkes beløbet; afviser du, frigives reservationen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Karte des Artists ist autorisiert. Annehmen bucht ab, Ablehnen gibt den Betrag frei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κάρτα του καλλιτέχνη έχει εγκριθεί. Αν αποδεχτείς, χρεώνεται· αν απορρίψεις, αποδεσμεύεται."
          }
        },
        "es": {
