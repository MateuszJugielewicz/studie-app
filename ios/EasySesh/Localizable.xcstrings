    "I agree to the studio's rules and the %@ cancellation policy.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg accepterer studiets regler og afbestillingspolitikken (%@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich stimme den Regeln des Studios und der Stornobedingung „%@“ zu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συμφωνώ με τους κανόνες του στούντιο και την πολιτική ακύρωσης (%@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acepto las normas del estudio y la política de cancelación (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'accepte les règles du studio et la politique d'annulation (%@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetto le regole dello studio e la politica di cancellazione (%@)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ga akkoord met de regels van de studio en het annuleringsbeleid (%@)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Akceptuję zasady studia i zasady anulowania (%@)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag godkänner studions regler och avbokningspolicyn (%@)."
          }
        }
      }
    },
