          "stringUnit": {
            "state": "translated",
            "value": "Questo studio ha disattivato il check-in. EasySesh non può promettere un rimborso se qualcosa va storto con questa sessione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze studio heeft inchecken uitgezet. EasySesh kan geen terugbetaling beloven als er iets misgaat met deze sessie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To studio wyłączyło zameldowanie. EasySesh nie może obiecać zwrotu, jeśli coś pójdzie nie tak z sesją."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Studion har stängt av incheckning. EasySesh kan inte lova återbetalning om något går fel med sessionen."
          }
        }
      }
    },
