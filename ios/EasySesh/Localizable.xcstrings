    "Thanks! We're reviewing your studio and will notify you, usually within 1–2 business days.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak! Vi gennemgår dit studie og giver dig besked, normalt inden for 1–2 hverdage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke! Wir prüfen dein Studio und melden uns, meist innerhalb von 1–2 Werktagen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ευχαριστούμε! Ελέγχουμε το στούντιό σου και θα σε ειδοποιήσουμε, συνήθως σε 1–2 εργάσιμες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gracias! Estamos revisando tu estudio y te avisaremos, normalmente en 1–2 días laborables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci ! Nous examinons ton studio et te préviendrons, en général sous 1 à 2 jours ouvrés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie! Stiamo verificando lo studio e ti avviseremo, di solito entro 1–2 giorni lavorativi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedankt! We beoordelen je studio en laten het je weten, meestal binnen 1–2 werkdagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzięki! Sprawdzamy Twoje studio i damy znać, zwykle w ciągu 1–2 dni roboczych."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack! Vi granskar din studio och hör av oss, oftast inom 1–2 arbetsdagar."
          }
        }
      }
    },
    "That time is no longer available. Please pick another slot.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiden er ikke længere ledig. Vælg en anden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Zeit ist nicht mehr frei. Bitte wähle einen anderen Termin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η ώρα δεν είναι πλέον διαθέσιμη. Διάλεξε άλλη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa hora ya no está disponible. Elige otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce créneau n'est plus disponible. Choisis-en un autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo orario non è più disponibile. Scegline un altro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat tijdstip is niet meer beschikbaar. Kies een ander."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten termin nie jest już dostępny. Wybierz inny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den tiden är inte längre ledig. Välj en annan."
          }
        }
      }
    },
    "The artist has to confirm the connection from their profile, so only your own profile can be connected.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunstneren skal bekræfte tilknytningen fra sin profil, så kun din egen profil kan tilknyttes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Artist muss die Verbindung in seinem Profil bestätigen, daher kann nur dein eigenes Profil verbunden werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο καλλιτέχνης πρέπει να επιβεβαιώσει τη σύνδεση από το προφίλ του, οπότε συνδέεται μόνο το δικό σου προφίλ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El artista debe confirmar la conexión desde su perfil, así que solo puedes conectar tu propio perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'artiste doit confirmer le lien depuis son profil, donc seul ton propre profil peut être relié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'artista deve confermare il collegamento dal suo profilo, quindi puoi collegare solo il tuo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De artiest moet de koppeling in zijn profiel bevestigen, dus alleen je eigen profiel kan gekoppeld worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Artysta musi potwierdzić połączenie w swoim profilu, więc można połączyć tylko własny profil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Artisten måste bekräfta kopplingen i sin profil, så bara din egen profil kan kopplas."
          }
        }
      }
    },
