    "If someone is in danger, contact the local emergency services first.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis nogen er i fare, så kontakt først alarmcentralen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn jemand in Gefahr ist, wende dich zuerst an den Notruf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν κάποιος κινδυνεύει, επικοινώνησε πρώτα με τις υπηρεσίες έκτακτης ανάγκης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si alguien está en peligro, llama primero a emergencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si quelqu'un est en danger, contacte d'abord les services d'urgence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se qualcuno è in pericolo, contatta prima i servizi di emergenza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is iemand in gevaar? Bel dan eerst de hulpdiensten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli ktoś jest w niebezpieczeństwie, najpierw zadzwoń na numer alarmowy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om någon är i fara, kontakta först larmnumret."
          }
        }
      }
    },
