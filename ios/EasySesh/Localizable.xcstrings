    "Same session type and length (%lld h). To change the length, cancel and book again.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Samme sessionstype og længde (%lld t). Vil du ændre længden, så aflys og book igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleiche Session-Art und Länge (%lld Std.). Um die Länge zu ändern, storniere und buche neu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ίδιος τύπος και διάρκεια συνεδρίας (%lld ώρ.). Για αλλαγή διάρκειας, ακύρωσε και κλείσε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mismo tipo y duración de sesión (%lld h). Para cambiar la duración, cancela y reserva de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même type et même durée de session (%lld h). Pour changer la durée, annule et réserve à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stesso tipo e durata della sessione (%lld h). Per cambiare durata, annulla e prenota di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelfde soort sessie en duur (%lld u). Wil je de duur wijzigen, annuleer dan en boek opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten sam rodzaj i długość sesji (%lld godz.). Aby zmienić długość, anuluj i zarezerwuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samma sessionstyp och längd (%lld h). Vill du ändra längden, avboka och boka igen."
          }
        }
      }
    },
