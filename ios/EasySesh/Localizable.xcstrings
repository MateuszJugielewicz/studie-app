    "Cash booking: collect %@ at the session. EasySesh's %lld%% fee is deducted from your next payout or invoiced.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontantbooking: opkræv %@ ved sessionen. EasySeshs gebyr på %lld %% trækkes fra din næste udbetaling eller faktureres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Barbuchung: Kassiere %@ bei der Session. Die EasySesh-Gebühr von %lld %% wird von deiner nächsten Auszahlung abgezogen oder in Rechnung gestellt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κράτηση με μετρητά: εισέπραξε %@ στη συνεδρία. Η χρέωση %lld%% του EasySesh αφαιρείται από την επόμενη πληρωμή σου ή τιμολογείται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserva en efectivo: cobra %@ en la sesión. La tarifa del %lld %% de EasySesh se descuenta de tu próximo pago o se factura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réservation en espèces : encaisse %@ pendant la session. Les frais EasySesh de %lld %% sont déduits de ton prochain versement ou facturés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenotazione in contanti: incassa %@ alla sessione. La commissione EasySesh del %lld%% viene detratta dal prossimo pagamento o fatturata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Contante boeking: reken %@ af bij de sessie. De EasySesh-kosten van %lld%% worden van je volgende uitbetaling afgetrokken of gefactureerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezerwacja gotówkowa: pobierz %@ na sesji. Opłata EasySesh %lld%% zostanie potrącona z następnej wypłaty lub zafakturowana."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontantbokning: ta betalt %@ vid sessionen. EasySesh avgift på %lld %% dras från din nästa utbetalning eller faktureras."
          }
        }
      }
    },
