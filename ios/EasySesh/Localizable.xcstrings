    "This studio has turned off check-in. EasySesh can't promise a refund if something goes wrong with this session.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Studiet har slået tjek ind fra. EasySesh kan ikke love en refundering, hvis noget går galt med sessionen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Studio hat den Check-in ausgeschaltet. EasySesh kann keine Erstattung versprechen, wenn bei der Session etwas schiefgeht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το στούντιο έχει απενεργοποιήσει το check-in. Το EasySesh δεν μπορεί να υποσχεθεί επιστροφή χρημάτων αν κάτι πάει στραβά με τη συνεδρία."
          }
        },
        "es": {
