          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εγκρίσεις στούντιο, οι χρήστες, οι κρατήσεις, οι πληρωμές και η εποπτεία γίνονται από τον πίνακα διαχείρισης του EasySesh στο web."
          }
        },
        "es": {
          "stringUnit": {
