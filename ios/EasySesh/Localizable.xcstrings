    "We've received your order. You'll get an invoice by email, and the promotion starts once it's paid.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har modtaget din bestilling. Du får en faktura på e-mail, og promoveringen starter, når den er betalt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben deine Bestellung erhalten. Du bekommst eine Rechnung per E-Mail, und die Werbung startet nach Zahlung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λάβαμε την παραγγελία σου. Θα πάρεις τιμολόγιο με email και η προβολή ξεκινά μόλις πληρωθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemos recibido tu pedido. Recibirás una factura por correo y la promoción empezará cuando se pague."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons reçu ta commande. Tu recevras une facture par e-mail et la mise en avant démarrera une fois payée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo ricevuto l'ordine. Riceverai una fattura via email e la promozione partirà una volta pagata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
