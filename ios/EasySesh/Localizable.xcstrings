    "You accept or decline each request within 24 hours; unanswered requests expire. Card payments are only charged when you accept.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du accepterer eller afviser hver forespørgsel inden for 24 timer; ubesvarede forespørgsler udløber. Kortbetalinger trækkes først, når du accepterer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du nimmst jede Anfrage innerhalb von 24 Stunden an oder lehnst sie ab; unbeantwortete Anfragen verfallen. Kartenzahlungen werden erst bei Annahme belastet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποδέχεσαι ή απορρίπτεις κάθε αίτημα εντός 24 ωρών· τα αναπάντητα λήγουν. Οι πληρωμές με κάρτα χρεώνονται μόνο όταν αποδεχτείς."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceptas o rechazas cada solicitud en 24 horas; las que no respondas caducan. Los pagos con tarjeta solo se cobran al aceptar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu acceptes ou refuses chaque demande sous 24 heures ; sans réponse, elle expire. Les paiements par carte ne sont débités qu'à l'acceptation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetti o rifiuti ogni richiesta entro 24 ore; quelle senza risposta scadono. I pagamenti con carta sono addebitati solo quando accetti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je accepteert of weigert elke aanvraag binnen 24 uur; onbeantwoorde aanvragen vervallen. Kaartbetalingen worden pas afgeschreven als je accepteert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Akceptujesz lub odrzucasz każdą prośbę w ciągu 24 godzin; prośby bez odpowiedzi wygasają. Płatności kartą są pobierane dopiero po akceptacji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du accepterar eller avböjer varje förfrågan inom 24 timmar; obesvarade förfrågningar går ut. Kortbetalningar dras först när du accepterar."
          }
        }
      }
    },
