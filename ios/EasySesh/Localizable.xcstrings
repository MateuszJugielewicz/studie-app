    "Check in in the app when you arrive. EasySesh recommends it: it protects you against fraud and helps us sort out any problem.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek ind i appen, når du ankommer. EasySesh anbefaler det: det beskytter dig mod svindel og hjælper os med at løse eventuelle problemer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Checke bei Ankunft in der App ein. EasySesh empfiehlt es: Es schützt dich vor Betrug und hilft uns bei Problemen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάνε check-in στην εφαρμογή όταν φτάσεις. Το EasySesh το προτείνει: σε προστατεύει από απάτη και μας βοηθά να λύσουμε κάθε πρόβλημα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz check-in en la app al llegar. EasySesh lo recomienda: te protege del fraude y nos ayuda a resolver cualquier problema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre-toi dans l'app à ton arrivée. EasySesh le recommande : cela te protège contre la fraude et nous aide à régler tout problème."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai il check-in nell'app quando arrivi. EasySesh lo consiglia: ti protegge dalle frodi e ci aiuta a risolvere ogni problema."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Check in in de app als je aankomt. EasySesh raadt het aan: het beschermt je tegen fraude en helpt ons problemen op te lossen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamelduj się w aplikacji po przybyciu. EasySesh to zaleca: chroni Cię przed oszustwem i pomaga nam rozwiązać ewentualne problemy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Checka in i appen när du kommer. EasySesh rekommenderar det: det skyddar dig mot bedrägeri och hjälper oss att lösa eventuella problem."
          }
        }
      }
    },
    "Check your inbox for a reset link.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek din indbakke for et link til nulstilling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh in deinem Posteingang nach dem Link."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έλεγξε τα εισερχόμενα για τον σύνδεσμο επαναφοράς."
          }
        },
        "es": {
