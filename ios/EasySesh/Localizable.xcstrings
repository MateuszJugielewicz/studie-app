    "Please tell the artist why you're cancelling.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortæl kunstneren, hvorfor du aflyser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte sag dem Artist, warum du absagst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πες στον καλλιτέχνη γιατί ακυρώνεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explica al artista por qué cancelas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explique à l'artiste pourquoi tu annules."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiega all'artista perché annulli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de artiest weten waarom je annuleert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisz artyście, dlaczego odwołujesz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Berätta för artisten varför du avbokar."
          }
        }
      }
    },
    "Please update the app to read and accept the latest terms.": {
      "extractionState": "manual",
      "localizations": {
