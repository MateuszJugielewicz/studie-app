    "What are you working on? Anything they should prepare?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad arbejder du på? Er der noget, de skal forberede?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Woran arbeitest du? Sollen sie etwas vorbereiten?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε τι δουλεύεις; Χρειάζεται να προετοιμάσουν κάτι;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿En qué estás trabajando? ¿Deben preparar algo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
