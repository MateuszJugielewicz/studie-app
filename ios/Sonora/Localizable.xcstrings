    "Pick a time, pay securely in the app or in cash at the studio, and get instant confirmation.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et tidspunkt, betal sikkert i appen eller kontant i studiet, og få bekræftelse med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Zeit, bezahle sicher in der App oder bar im Studio und erhalte sofort eine Bestätigung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε ώρα, πλήρωσε με ασφάλεια στην εφαρμογή ή με μετρητά στο στούντιο και πάρε άμεση επιβεβαίωση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una hora, paga de forma segura en la app o en efectivo en el estudio y recibe confirmación al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un horaire, paie en toute sécurité dans l'app ou en espèces au studio, et reçois une confirmation immédiate."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un orario, paga in sicurezza nell'app o in contanti allo studio e ricevi subito la conferma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een tijd, betaal veilig in de app of contant in de studio en krijg direct een bevestiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz termin, zapłać bezpiecznie w aplikacji lub gotówką w studiu i od razu otrzymaj potwierdzenie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en tid, betala säkert i appen eller kontant i studion och få bekräftelse direkt."
          }
        }
      }
    },
