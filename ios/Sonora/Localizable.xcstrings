    "Edit your listing, prices and opening hours, set up payouts and change app settings.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigér din annonce, priser og åbningstider, opsæt udbetalinger og skift appindstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeite dein Profil, Preise und Öffnungszeiten, richte Auszahlungen ein und ändere App-Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επεξεργάσου την καταχώριση, τιμές και ωράριο, ρύθμισε πληρωμές και ρυθμίσεις εφαρμογής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita tu anuncio, precios y horario, configura los pagos y los ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie ton annonce, tes tarifs et horaires, configure les versements et les réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica annuncio, prezzi e orari, imposta i pagamenti e le impostazioni dell'app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewerk je vermelding, prijzen en openingstijden, stel uitbetalingen en app-instellingen in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytuj ogłoszenie, ceny i godziny, skonfiguruj wypłaty i ustawienia aplikacji."
          }
        },
        "sv": {
