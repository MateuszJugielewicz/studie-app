    "Accept to reply. They won't know you've seen it until you do.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceptér for at svare. De ved ikke, at du har set den, før du gør."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm an, um zu antworten. Vorher sieht niemand, dass du es gelesen hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποδέξου για να απαντήσεις. Δεν θα ξέρουν ότι το είδες μέχρι τότε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acepta para responder. No sabrán que lo has visto hasta entonces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepte pour répondre. Personne ne saura que tu l'as vu avant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetta per rispondere. Non sapranno che l'hai visto finché non lo fai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepteer om te antwoorden. Ze weten pas dat je het gezien hebt als je dat doet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaakceptuj, aby odpowiedzieć. Nie dowiedzą się, że to widziałeś, dopóki tego nie zrobisz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceptera för att svara. De vet inte att du sett det förrän du gör det."
          }
        }
      }
    },
