    "We've sent a confirmation and receipt. We'll remind you before your session.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har sendt en bekræftelse og kvittering. Vi minder dig om det før din session."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigung und Beleg sind unterwegs. Wir erinnern dich vor der Session."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στείλαμε επιβεβαίωση και απόδειξη. Θα σου το θυμίσουμε πριν τη συνεδρία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te hemos enviado la confirmación y el recibo. Te lo recordaremos antes de la sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmation et reçu envoyés. Nous te le rappellerons avant ta session."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti abbiamo inviato conferma e ricevuta. Te lo ricorderemo prima della sessione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben een bevestiging en bon gestuurd. We herinneren je voor je sessie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłaliśmy potwierdzenie i paragon. Przypomnimy ci przed sesją."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har skickat bekräftelse och kvitto. Vi påminner dig före sessionen."
          }
        }
      }
    },
