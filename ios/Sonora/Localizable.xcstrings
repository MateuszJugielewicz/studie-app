    "Reduce visual effects turns off moving backgrounds and pulsing animations. It can also save battery.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducér visuelle effekter slår bevægelige baggrunde og pulserende animationer fra. Det kan også spare batteri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit werden bewegte Hintergründe und pulsierende Animationen ausgeschaltet. Das kann auch Akku sparen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποιεί τα κινούμενα φόντα και τα κινούμενα εφέ. Εξοικονομεί επίσης μπαταρία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva los fondos en movimiento y las animaciones. También puede ahorrar batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive les fonds animés et les animations pulsées. Cela peut aussi économiser la batterie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva sfondi animati e animazioni pulsanti. Può anche far risparmiare batteria."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakelt bewegende achtergronden en pulserende animaties uit. Dit kan ook batterij besparen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącza ruchome tła i pulsujące animacje. Może też oszczędzać baterię."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stänger av rörliga bakgrunder och pulserande animationer. Det kan också spara batteri."
          }
        }
      }
    },
