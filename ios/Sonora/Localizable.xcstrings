    "List your rooms, fill your calendar and get paid. Every studio is reviewed before it goes live.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis dine rum, fyld kalenderen og få penge ind. Alle studier bliver gennemgået, før de går live."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell deine Räume ein, füll deinen Kalender und werde bezahlt. Jedes Studio wird vor der Freischaltung geprüft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταχώρισε τους χώρους σου, γέμισε το ημερολόγιο και πληρώσου. Κάθε στούντιο ελέγχεται πριν δημοσιευτεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Publica tus salas, llena tu calendario y cobra. Cada estudio se revisa antes de publicarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Présente tes salles, remplis ton agenda et sois payé. Chaque studio est vérifié avant sa mise en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubblica le tue sale, riempi il calendario e fatti pagare. Ogni studio viene verificato prima di andare online."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet je ruimtes online, vul je agenda en word betaald. Elke studio wordt gecontroleerd voordat hij live gaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj swoje pomieszczenia, zapełnij kalendarz i zarabiaj. Każde studio jest sprawdzane przed publikacją."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg upp dina rum, fyll kalendern och få betalt. Varje studio granskas innan den publiceras."
          }
        }
