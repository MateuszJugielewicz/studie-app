    "They'll get it as a message request and can accept or delete it.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De får den som en beskedanmodning og kan acceptere eller slette den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kommt als Nachrichtenanfrage an und kann angenommen oder gelöscht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα το λάβουν ως αίτημα μηνύματος και μπορούν να το αποδεχτούν ή να το διαγράψουν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo recibirá como solicitud de mensaje y podrá aceptarla o eliminarla."
          }
