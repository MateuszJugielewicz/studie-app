          "stringUnit": {
            "state": "translated",
            "value": "Vi svarer normalt inden for 24 timer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir antworten meist innerhalb von 24 Stunden."
          }
        },
