          "stringUnit": {
            "state": "translated",
            "value": "Le message arrivera comme demande, qu'il pourra accepter ou supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo riceverà come richiesta di messaggio e potrà accettarla o eliminarla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze krijgen het als berichtverzoek en kunnen het accepteren of verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymają ją jako prośbę o wiadomość i mogą ją zaakceptować lub usunąć."
          }
        },
        "sv": {
          "stringUnit": {
