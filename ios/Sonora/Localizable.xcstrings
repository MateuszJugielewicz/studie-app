    "Earnings, booking requests and upcoming sessions at a glance. Go live or pause your studio here.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtjening, bookinganmodninger og kommende sessions på ét sted. Gå live eller sæt studiet på pause her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einnahmen, Anfragen und anstehende Sessions auf einen Blick. Hier gehst du live oder pausierst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έσοδα, αιτήματα κρατήσεων και επερχόμενες συνεδρίες με μια ματιά. Εδώ ενεργοποιείς ή σταματάς το στούντιο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresos, solicitudes y próximas sesiones de un vistazo. Activa o pausa tu estudio aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenus, demandes et sessions à venir en un coup d'œil. Mets ton studio en ligne ou en pause ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guadagni, richieste e sessioni in arrivo a colpo d'occhio. Metti online o in pausa lo studio da qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkomsten, aanvragen en komende sessies in één oogopslag. Zet je studio hier live of op pauze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarobki, prośby o rezerwację i nadchodzące sesje w jednym miejscu. Tu włączysz lub wstrzymasz studio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Intäkter, förfrågningar och kommande sessioner i en överblick. Gå live eller pausa studion här."
          }
        }
      }
    },
