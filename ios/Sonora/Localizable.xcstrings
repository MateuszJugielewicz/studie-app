    "Photos are downloaded again when you need them. Your account, bookings and messages are not affected.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billeder hentes igen, når du skal bruge dem. Din konto, bookinger og beskeder påvirkes ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos werden bei Bedarf neu geladen. Konto, Buchungen und Nachrichten bleiben erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωτογραφίες θα κατέβουν ξανά όταν χρειαστεί. Ο λογαριασμός, οι κρατήσεις και τα μηνύματα δεν επηρεάζονται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se descargan de nuevo cuando las necesites. Tu cuenta, reservas y mensajes no se ven afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos sont retéléchargées si besoin. Ton compte, tes réservations et tes messages ne sont pas affectés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto vengono riscaricate quando servono. Account, prenotazioni e messaggi non vengono toccati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto's worden opnieuw gedownload wanneer nodig. Je account, boekingen en berichten blijven behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia zostaną pobrane ponownie, gdy będą potrzebne. Konto, rezerwacje i wiadomości pozostaną bez zmian."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder laddas ner igen när de behövs. Konto, bokningar och meddelanden påverkas inte."
          }
        }
      }
    },
