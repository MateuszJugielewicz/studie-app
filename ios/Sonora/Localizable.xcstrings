    "Your studio was approved and artists can now book you. Here's a 30-second tour of where everything is.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit studie er godkendt, og kunstnere kan nu booke dig. Her er en rundvisning på 30 sekunder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Studio wurde freigegeben und kann jetzt gebucht werden. Hier ist eine 30-Sekunden-Tour."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το στούντιό σου εγκρίθηκε και οι καλλιτέχνες μπορούν να κάνουν κράτηση. Ορίστε μια ξενάγηση 30 δευτερολέπτων."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu estudio ha sido aprobado y ya pueden reservarte. Aquí tienes un tour de 30 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton studio a été approuvé et les artistes peuvent réserver. Voici une visite de 30 secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo studio è stato approvato e gli artisti possono prenotare. Ecco un tour di 30 secondi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je studio is goedgekeurd en artiesten kunnen je nu boeken. Hier is een tour van 30 seconden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje studio zostało zatwierdzone i artyści mogą już rezerwować. Oto 30-sekundowy przewodnik."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din studio är godkänd och artister kan nu boka dig. Här är en guide på 30 sekunder."
          }
        }
      }
    }
  },
  "version": "1.0"
}
