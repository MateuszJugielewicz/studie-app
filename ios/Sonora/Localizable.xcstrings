    "Most text changes right away. A few system texts update the next time you open the app.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det meste tekst skifter med det samme. Enkelte systemtekster opdateres, næste gang du åbner appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meisten Texte ändern sich sofort. Einige Systemtexte erst beim nächsten Öffnen der App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα περισσότερα κείμενα αλλάζουν αμέσως. Ορισμένα κείμενα συστήματος αλλάζουν στο επόμενο άνοιγμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría de textos cambian al instante. Algunos textos del sistema cambian al volver a abrir la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart des textes changent tout de suite. Certains textes système changent à la prochaine ouverture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La maggior parte dei testi cambia subito. Alcuni testi di sistema alla prossima apertura dell'app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De meeste teksten veranderen meteen. Sommige systeemteksten pas bij de volgende keer openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Większość tekstów zmienia się od razu. Niektóre teksty systemowe zmienią się po ponownym otwarciu aplikacji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det mesta ändras direkt. Vissa systemtexter uppdateras nästa gång du öppnar appen."
          }
        }
      }
    },
