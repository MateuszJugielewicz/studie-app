    "Every session by day. Block time when the studio is busy so nobody can book it.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle sessions dag for dag. Blokér tid, når studiet er optaget, så ingen kan booke den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Sessions nach Tagen. Blockiere Zeiten, wenn das Studio belegt ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλες οι συνεδρίες ανά ημέρα. Μπλόκαρε ώρες όταν το στούντιο είναι απασχολημένο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las sesiones por día. Bloquea horas cuando el estudio esté ocupado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les sessions jour par jour. Bloque les créneaux quand le studio est occupé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le sessioni giorno per giorno. Blocca gli orari quando lo studio è occupato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle sessies per dag. Blokkeer tijd wanneer de studio bezet is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie sesje dzień po dniu. Zablokuj czas, gdy studio jest zajęte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla sessioner dag för dag. Blockera tid när studion är upptagen."
          }
        }
      }
    },
