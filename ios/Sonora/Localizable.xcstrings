    "Find rooms, gear and engineers near you. See real prices and availability, book and pay in one place.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Find rum, udstyr og teknikere tæt på dig. Se rigtige priser og ledige tider, book og betal ét sted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde Räume, Equipment und Tontechnik in deiner Nähe. Echte Preise und Verfügbarkeit – buchen und bezahlen an einem Ort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρες χώρους, εξοπλισμό και ηχολήπτες κοντά σου. Δες τιμές και διαθεσιμότητα, κλείσε και πλήρωσε σε ένα σημείο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra salas, equipo y técnicos cerca de ti. Precios reales y disponibilidad, reserva y paga en un solo lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve des salles, du matériel et des ingés son près de chez toi. Prix réels, disponibilités, réservation et paiement au même endroit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova sale, attrezzatura e fonici vicino a te. Prezzi reali e disponibilità, prenota e paga in un unico posto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind ruimtes, apparatuur en technici bij jou in de buurt. Echte prijzen en beschikbaarheid, boeken en betalen op één plek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź sale, sprzęt i realizatorów w pobliżu. Zobacz ceny i dostępność, rezerwuj i płać w jednym miejscu."
          }
        },
