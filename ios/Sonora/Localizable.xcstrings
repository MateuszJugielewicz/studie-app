    "When a studio you haven't booked writes to you, it shows up here first.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når et studie, du ikke har booket, skriver til dig, dukker det op her først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt dir ein Studio, das du noch nicht gebucht hast, landet es zuerst hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν σου γράφει στούντιο που δεν έχεις κλείσει, εμφανίζεται πρώτα εδώ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando te escribe un estudio que no has reservado, aparece aquí primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un studio que tu n'as pas réservé t'écrit, son message arrive d'abord ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ti scrive uno studio che non hai prenotato, compare prima qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een studio die je nog niet hebt geboekt je schrijft, verschijnt dat eerst hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy napisze do ciebie studio, którego nie rezerwowałeś, wiadomość pojawi się najpierw tutaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När en studio du inte bokat skriver till dig hamnar det här först."
          }
        }
